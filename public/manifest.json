{
  "manifest_version": 3,
  "name": "照面 Glimpse",
  "short_name": "照面",
  "version": "1.12.0",
  "minimum_chrome_version": "120",
  "description": "看一眼，找到熟悉的页面。通过缩略图总览、快捷搜索和窗口筛选，快速查找、切换和整理浏览器标签页。",
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "activeTab",
    "favicon",
    "storage",
    "alarms",
    "sessions",
    "tabGroups"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "打开照面 Glimpse",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "assets/activity.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "Command+Shift+Period"
      },
      "description": "打开照面 Glimpse 总览"
    }
  }
}
